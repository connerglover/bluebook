# Cloudflare Pages header rules.

/*
  # The app renders SVG and HTML that come out of a .bbtest the student picked
  # off their own disk. figure.js scrubs that markup, and this is the second
  # line of defence: no remote script can run even if something slipped past.
  #
  # 'unsafe-inline' for style-src is required — the runtime sets inline styles
  # for the line reader, the split pane, and the draggable calculator.
  # frame-src allows the TI-84 emulator's isolated srcdoc frame.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://mn.testnav.com; frame-src 'self' blob: https://mn.testnav.com; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The TI-84 emulator runs on its own page precisely so this looser policy does
# not have to apply to the exam. It loads TI's engine and TestNav's stylesheet
# from mn.testnav.com and runs one inline bootstrap script.
/ti84.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://mn.testnav.com; style-src 'self' 'unsafe-inline' https://mn.testnav.com; img-src 'self' data: blob: https://mn.testnav.com; font-src https://mn.testnav.com data:; connect-src https://mn.testnav.com; frame-ancestors 'self'; base-uri 'none'
  X-Content-Type-Options: nosniff

# Hashed asset filenames change whenever their content does, so they can be
# cached hard. The HTML must not be, or a deploy never reaches anyone.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
